# Use these only in your local PowerShell session or an ignored .env file.
# Never commit real credentials. The API key belongs only in the Function environment.
APPWRITE_ENDPOINT=https://REGION.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=YOUR_PROJECT_ID
APPWRITE_API_KEY=YOUR_SERVER_API_KEY
APPWRITE_DATABASE_ID=parkfinder
JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
AI_INGEST_API_KEY=GENERATE_A_DIFFERENT_RANDOM_SECRET
